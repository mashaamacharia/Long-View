# ---------- Postgres ----------
POSTGRES_USER=longview
POSTGRES_PASSWORD=longview
POSTGRES_DB=longview
POSTGRES_HOST=postgres
POSTGRES_HOST_PORT=5433
# Used by the backend, MCP server and Alembic (inside Docker, host is "postgres").
# When running outside Docker, use localhost instead.
DATABASE_URL=postgresql+psycopg://longview:longview@postgres:5432/longview

# ---------- LLM ----------
# ollama = open-weights Qwen (default, required for the demo + evals)
# gemini = dev/comparison only
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
# Pick a small Qwen instruct model that fits 16GB RAM CPU-only; check the Ollama library for current tags.
OLLAMA_MODEL=hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- MCP ----------
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8001
LEARNER_MCP_URL=http://mcp-server:8001/mcp

# ---------- App ----------
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
